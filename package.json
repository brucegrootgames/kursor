{
  "name": "kursor",
  "displayName": "Kursor",
  "description": "Cursor-style AI coding features powered by the Claude Code installed on your machine.",
  "version": "0.1.0",
  "publisher": "kursor",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=20"
  },
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/webview/tsconfig.json",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository -o dist/kursor.vsix"
  },
  "devDependencies": {
    "@types/diff": "^5.2.3",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.278",
    "@vscode/codicons": "^0.0.46-24",
    "diff": "^5.2.2",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
